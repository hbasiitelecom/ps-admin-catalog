{
  "$schema": "./schema/catalog.schema.json",
  "schemaVersion": 1,
  "catalogVersion": "2.1.0",
  "name": "Catalogue PowerShell Microsoft 365",
  "description": "Sources, regles de compatibilite PowerShell 7, index publies et annotations pour PS Admin Launcher. Seuls des scripts lancables sont references.",
  "okLabel": "PS7",
  "indexBaseUrl": "https://raw.githubusercontent.com/hbasiitelecom/ps-admin-catalog/index/",
  "sources": [
    {
      "id": "admindroid",
      "name": "AdminDroid Community",
      "owner": "admindroid-community",
      "repo": "powershell-scripts",
      "branch": "master",
      "layout": "folders",
      "trust": "community",
      "license": "aucune",
      "note": "183 scripts autonomes, un dossier par script avec son README. Aucune licence declaree : usage interne uniquement.",
      "enabled": true
    },
    {
      "id": "o365itpros",
      "name": "Office365ITPros",
      "owner": "12Knocksinna",
      "repo": "Office365itpros",
      "branch": "master",
      "layout": "flat",
      "trust": "verified",
      "license": "MIT",
      "note": "406 scripts autonomes a la racine du depot. Source de reference de la communaute M365, active. Pas de README par script : la documentation vient de l'en-tete.",
      "enabled": false
    },
    {
      "id": "mike-crowley",
      "name": "Mike Crowley - Public Scripts",
      "owner": "Mike-Crowley",
      "repo": "Public-Scripts",
      "branch": "main",
      "layout": "tree",
      "trust": "community",
      "license": "GPL-3.0",
      "note": "38 scripts M365, Exchange, SharePoint, Entra. Petit mais qualitatif.",
