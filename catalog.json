    },
    {
      "id": "m365corner",
      "name": "M365Corner",
      "owner": "m365corner",
      "repo": "M365Corner-Scripts",
      "branch": "main",
      "layout": "tree",
      "trust": "unknown",
      "license": "aucune",
      "note": "Scripts Graph orientes resolution de problemes. Aucune licence declaree, depot recent.",
      "enabled": false
    },
    {
      "id": "exchange4itpros",
      "name": "Exchange4ITPros",
      "owner": "Apoc70",
      "repo": "Exchange4ITPros",
      "branch": "main",
      "layout": "tree",
      "trust": "community",
      "license": "MIT",
      "note": "Structure par service, un README par script. Seulement 14 fichiers .ps1 : verifier le rendement avant activation.",
      "enabled": false
    },
    {
      "id": "monkey365",
      "name": "Monkey365",
      "owner": "silverhack",
      "repo": "monkey365",
      "branch": "main",
      "layout": "tree",
      "trust": "verified",
      "license": "Apache-2.0",
      "note": "Deux points d'entree seulement : Invoke-Monkey365.ps1 et monkey365.ps1. Les 388 autres .ps1 du depot sont le coeur du module et ses collecteurs, des fonctions internes qui ne se lancent pas seules.",
      "enabled": false,
      "include": [
        "/invoke-monkey365.ps1",
        "/monkey365.ps1"
      ]
    },
    {
      "id": "msendpointmgr",
      "name": "MSEndpointMgr - Intune",
      "owner": "MSEndpointMgr",
      "repo": "Intune",
      "branch": "master",
      "layout": "tree",
      "trust": "verified",
      "license": "MIT",
      "note": "Intune et gestion du parc. 62 fichiers .ps1, structure mixte : verifier l'eligibilite avant activation.",
      "enabled": false
    },
    {
      "id": "devolutions",
      "name": "Devolutions ScriptLibrary",
      "owner": "Devolutions",
      "repo": "ScriptLibrary",
      "branch": "main",
      "layout": "tree",
      "trust": "community",
      "license": "aucune",
      "note": "Administration IT generale : AD, Azure, DNS, Entra, M365, Intune. Aucune licence declaree.",
      "enabled": false
    },
    {
      "id": "365inspect",
      "name": "365Inspect",
      "owner": "soteria-security",
      "repo": "365Inspect",
      "branch": "main",
      "layout": "tree",
      "trust": "verified",
      "license": "MIT",
      "note": "Deux points d'entree : 365Inspect.ps1, qui mene l'audit, et Create-365InspectApp.ps1, qui prepare l'application Entra. Les 108 fichiers d'Inspectors/ sont des fonctions appelees par le premier.",
      "enabled": false,
      "include": [
        "/365inspect.ps1",
        "/create-365inspectapp.ps1"
      ]
    },
    {
      "id": "mggraph-intune",
      "name": "Microsoft Graph Intune Samples",
      "owner": "microsoft",
      "repo": "mggraph-intune-samples",
      "branch": "main",
      "layout": "tree",
      "trust": "official",
      "license": "MIT",
      "note": "Exemples Intune sur le SDK Graph. Remplace microsoftgraph/powershell-intune-samples, desormais en lecture seule.",
      "enabled": false
    }
  ],
  "services": [
    {
      "id": "exo",
      "label": "Exchange Online",
      "icon": "E715",
      "pattern": "Connect-ExchangeOnline"
    },
    {
      "id": "graph",
      "label": "Microsoft Graph/Entra",
      "icon": "E753",
      "pattern": "Connect-MgGraph"
    },
    {
      "id": "spo",
      "label": "SharePoint/OneDrive",
      "icon": "E8B7",
      "pattern": "Connect-PnPOnline|Connect-SPOService"
    },
    {
      "id": "teams",
      "label": "Microsoft Teams",
      "icon": "E716",
      "pattern": "Connect-MicrosoftTeams"
    },
    {
      "id": "scc",
      "label": "Securite & Conformite",
      "icon": "E72E",
      "pattern": "Connect-IPPSSession"
    },
    {
      "id": "aad",
      "label": "Azure AD (obsolete)",
      "icon": "E7BA",
      "pattern": "Connect-MsolService|Connect-AzureAD"
    }
  ],
  "rules": [
    {
      "id": "retired-modules",
      "severity": "broken",
      "label": "Obsolete",
      "pattern": "Connect-MsolService|Connect-AzureAD\\b|Import-Module\\s+\\W{0,2}MSOnline|Import-Module\\s+\\W{0,2}AzureAD|\\bGet-Msol|\\bSet-Msol|\\bNew-Msol|\\bGet-AzureAD|\\bSet-AzureAD|\\bNew-AzureAD|\\bGet-WmiObject\\b",
      "reason": "Ce script s'appuie sur les modules MSOnline / AzureAD (ou sur Get-WmiObject), retires par Microsoft et non supportes par PowerShell 7. Il ne fonctionnera pas en l'etat : l'equivalent moderne passe par Microsoft Graph PowerShell."
    },
    {
      "id": "spo-legacy-module",
      "severity": "warn",
      "label": "A verifier",
      "pattern": "Connect-SPOService|Import-Module\\s+\\W{0,2}Microsoft\\.Online\\.SharePoint\\.PowerShell",
      "reason": "Ce script utilise le module Microsoft.Online.SharePoint.PowerShell, qui n'est pas nativement compatible PowerShell 7. Importez-le avec : Import-Module Microsoft.Online.SharePoint.PowerShell -UseWindowsPowerShell"
    }
  ],
  "overrides": [],
